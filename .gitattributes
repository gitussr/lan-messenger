# Normalize all text files to LF in the repo, regardless of platform
# checkout settings (fixes "LF will be replaced by CRLF" warnings on Windows).
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

*.pdf binary
*.db binary
*.exe binary
